{
  "name": "@nc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/services/search-query.test.ts src/services/claude.test.ts src/routes/backup.test.ts src/routes/core.integration.test.ts src/services/article-draft.test.ts src/services/page-review.test.ts src/services/claude-usage.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nc/shared": "workspace:*",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "officeparser": "^8.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "unpdf": "^1.9.0",
    "unzipper": "^0.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
