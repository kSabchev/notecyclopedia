# Server
PORT=3001
DATABASE_URL=postgres://nc:nc@localhost:5432/notecyclopedia
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Dedicated database for `pnpm test`; its name must end in _test. The tests read only this line from .env.
NC_TEST_DATABASE_URL=postgres://nc:nc@localhost:5432/notecyclopedia_test

# AI (the portal works without keys, but AI calls return a "not configured" message)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional model per feature, overriding ANTHROPIC_MODEL. Features: ask, tutor, check, summarize, solve,
# calculator (AI portal modes), calculator-spec, calculator-review, article-draft, page-review, image. Example:
# ANTHROPIC_MODELS_JSON={"ask":"claude-haiku-5-5","summarize":"claude-haiku-5-5"}
ANTHROPIC_MODELS_JSON=
# Tokens each user may spend on AI per rolling 24 hours (input + output + cache writes). 0 = no limit.
AI_DAILY_TOKEN_LIMIT=2000000
# Comma-separated account emails allowed to view Claude API logs (including full prompts).
ADMIN_EMAILS=
# Full prompt logs are automatically removed after this many days (default 90).
ANTHROPIC_LOG_RETENTION_DAYS=90
# USD per million tokens. Add/update entries for the models enabled on your account.
# Costs are estimates and rates should be kept current with Anthropic's published pricing.
ANTHROPIC_PRICING_JSON={"claude-sonnet-5-5":{"input":2,"output":10,"cacheRead":0.2,"cacheWrite5m":2.5,"cacheWrite1h":4},"claude-haiku-5-5":{"input":0.1,"output":0.5,"cacheRead":0.01,"cacheWrite5m":0.125,"cacheWrite1h":0.2},"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite5m":5,"cacheWrite1h":8}}
# Optional: multilingual embeddings for semantic search (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
